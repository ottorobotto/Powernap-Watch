  (text "PowerNap spin 1 - generated from scripts/design.py (do not edit by hand; edit design.py and regenerate)." (exclude_from_sim no) (at 20.32 398 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "d33588cb-7d2f-57d8-8c00-fdbac1f3b587"))
  (text "Same nRF52840 pins as the Arduino Nano 33 BLE, so firmware v11 runs with one change: IMU.begin(BOSCH_ACCELEROMETER_ONLY)." (exclude_from_sim no) (at 20.32 401.2 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "d8f90a97-ebec-5c2c-835e-ca22a9ac23c9"))
  (text "Power: USB -> D1 -> VSYS, or battery -> Q1 -> VSYS.  VSYS -> U2 -> 3V3.  P0.22 (VDD_ENV) switches the sensor supplies on." (exclude_from_sim no) (at 20.32 404.4 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "0fd0fc8a-6a5e-56de-825d-8adf70e3e140"))
  (text "3V3 -> U4 -> 1V8 (pulse sensor).  3V3 -> U5 boost -> V5LED 5.1 V (green LED).  Buzzer runs from 3V3 (its rated range is 2-4 V)." (exclude_from_sim no) (at 20.32 407.6 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b65d5011-4e33-53be-ad5b-6239a452ccee"))
  (sheet_instances (path "/" (page "1")))
